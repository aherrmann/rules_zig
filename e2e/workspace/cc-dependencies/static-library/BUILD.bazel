load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_zig//zig:defs.bzl", "zig_configure", "zig_static_library")

zig_static_library(
    name = "add",
    main = "add.zig",
)

# Transition build mode to avoid Zig debug symbols in the static library.
zig_configure(
    name = "add-small",
    actual = ":add",
    mode = "release_small",
)

cc_test(
    name = "add-test",
    size = "small",
    srcs = ["add-test.c"],
    # fails on MacOS with, see https://github.com/hermeticbuild/rules_zig/actions/runs/29501161934/job/87632738367?pr=673#step:3:145
    #   ld: 64-bit mach-o member 'libadd_zcu.o' not 8-byte aligned in 'bazel-out/darwin_arm64-fastbuild-ST-8e42560474ff/bin/cc-dependencies/static-library/libadd.a'
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":add-small"],
)

# Pass through a cc_library to explicitly test transitive CcInfo handling.
cc_library(
    name = "c-add",
    deps = [":add"],
)

zig_static_library(
    name = "mul",
    main = "mul.zig",
    deps = [":c-add"],
)

# See add-small above for reasoning.
zig_configure(
    name = "mul-small",
    actual = ":mul",
    mode = "release_small",
)

cc_test(
    name = "mul-test",
    size = "small",
    srcs = ["mul-test.c"],
    # See add-test above.
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":mul-small"],
)
