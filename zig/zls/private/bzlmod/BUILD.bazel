load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "zls",
    srcs = ["zls.bzl"],
    visibility = ["//zig:__subpackages__"],
    deps = [
        "//zig/private:platforms",
        "//zig/zls/private/repo:toolchains_repo",
        "//zig/zls/private/repo:zls_repository",
        "@bazel_skylib//lib:sets",
    ],
)

# Execute `bazel run //util:update_filegroups` to update this target.
filegroup(
    name = "all_files",
    srcs = [
        ":BUILD.bazel",
        ":zls.bzl",
    ],
    visibility = ["//zig/zls/private:__pkg__"],
)
